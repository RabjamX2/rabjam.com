{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start SvelteKit Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*ready.*",
          "endsPattern": "^.*Local:.*http://localhost:5173.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Start Keyboard Standalone Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client/static/keyboard"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
